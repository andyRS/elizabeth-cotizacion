{
  "name": "cotizaciones-elizabeth-mendez",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node api/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "oxlint src api scripts",
    "test": "node --test api/tests/*.test.js",
    "preview": "vite preview --host 0.0.0.0",
    "hash:password": "node scripts/hash-password.js",
    "hash:session": "node scripts/generate-session-secret.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.86.0",
    "vite": "^6.0.5"
  }
}
